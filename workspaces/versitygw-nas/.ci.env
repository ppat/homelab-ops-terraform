# Placeholders for `terraform validate`/`tflint`, which never reach the gateway. Unlike every
# other workspace's, three of these variables drive apply-time side effects against a live
# store, and the documented `set -a && source .ci.env && set +a` runs AFTER an operator has
# exported the real ones -- so each value defaults rather than assigns, and sourcing this file
# can no longer point an apply at a placeholder. See terraform.tf for what to export.
BWS_ACCESS_TOKEN="${BWS_ACCESS_TOKEN:-dummy}"
VERSITYGW_ADMIN_ACCESS_KEY="${VERSITYGW_ADMIN_ACCESS_KEY:-dummy}"
VERSITYGW_ADMIN_ENDPOINT="${VERSITYGW_ADMIN_ENDPOINT:-https://dummy}"
VERSITYGW_ADMIN_REGION="${VERSITYGW_ADMIN_REGION:-us-east-1}"
VERSITYGW_ADMIN_SECRET_KEY="${VERSITYGW_ADMIN_SECRET_KEY:-dummy}"
